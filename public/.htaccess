<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  <IfModule mod_negotiation.c>
    Options -MultiViews
  </IfModule>
  RewriteRule ^index\.html$ - [L]
  # Social crawlers do not execute the SPA before reading Open Graph metadata.
  # Route public Creation share links through the server-rendered endpoint.
  RewriteRule ^share/creation/([A-Za-z0-9_-]{1,128})/?$ https://us-central1-planetcreationsdotnet.cloudfunctions.net/api/creation-share/$1 [R=302,L,NE]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # App shell must always be revalidated so new deploys are picked up
  # immediately by browsers AND the Electron client (which otherwise
  # caches a stale index.html that still points at the old JS bundle).
  <FilesMatch "^(index\.html|asset-manifest\.json|manifest\.json|service-worker\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  # Content-hashed assets are immutable — safe to cache for a long time.
  <FilesMatch "\.[0-9a-f]{8,}\.(js|css|woff2?|ttf|eot|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
