{
  "name": "planet-creation-net",
  "version": "1.0.41",
  "description": "PlanetCreations Desktop Client",
  "author": "PlanetCreations",
  "private": true,
  "main": "electron/main.js",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@tanstack/react-query": "^5.101.4",
    "adm-zip": "^0.6.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "firebase": "^12.16.0",
    "fuse.js": "^7.5.0",
    "mime-types": "^3.0.2",
    "obs-websocket-js": "^5.0.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "firebase-tools": "^15.28.1",
    "jsdom": "^30.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "build:electron": "vite build --mode electron",
    "test": "npm run test:frontend && npm run test:electron",
    "test:frontend": "vitest run",
    "test:electron": "node --test \"electron/modules/*.test.js\"",
    "test:firestore-rules": "firebase emulators:exec --only firestore --project demo-planetcreations-rules --config firebase.e2e.json \"node --test tests/firestore.rules.test.mjs && node --test tests/scalable-map-index.emulator.test.cjs\"",
    "test:installed-production": "node scripts/installed-production-smoke.mjs",
    "test:watch": "vitest",
    "deploy:ionos": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-ionos.ps1",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "package": "npm run build:electron && electron-builder",
    "package:store": "npm run build:electron && npm run package:store:artifact",
    "package:store:artifact": "electron-builder --config electron-builder.store.cjs --publish never",
    "verify:store-package": "node scripts/verify-store-package.cjs",
    "generate:appx-assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-appx-assets.ps1"
  },
  "overrides": {
    "js-yaml": "^4.3.1"
  },
  "build": {
    "extends": null,
    "appId": "com.planetcreations.app",
    "productName": "PlanetCreations Client",
    "files": [
      "build/**/*",
      "electron/**/*",
      "!electron/**/*.test.js",
      "!electron/modules/FrontierSaveWatcher.js"
    ],
    "publish": {
      "provider": "github",
      "owner": "kutmandur",
      "repo": "PlanetCreations",
      "private": true
    },
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "darkModeSupport": true,
      "hardenedRuntime": true
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "fileAssociations": [
      {
        "ext": "planetcreations",
        "name": "PlanetCreations Backup",
        "description": "Backup file for PlanetCreations Client"
      }
    ],
    "protocols": [
      {
        "name": "PlanetCreations Link",
        "schemes": [
          "planetcreations"
        ]
      }
    ]
  }
}
