# Existing Discord/Firebase configuration
DISCORD_TOKEN=
FIREBASE_SERVICE_ACCOUNT_B64=

# Twitch chat bot account. Use an Authorization Code Grant with chat:read and
# chat:edit. Rotated refresh tokens are persisted in server-only Firestore state.
TWITCH_BOT_USERNAME=
TWITCH_BOT_CLIENT_ID=
TWITCH_BOT_CLIENT_SECRET=
TWITCH_BOT_ACCESS_TOKEN=
TWITCH_BOT_REFRESH_TOKEN=

# YouTube bot OAuth Brand Channel (refresh token is normally loaded from Firestore)
YOUTUBE_BOT_CLIENT_ID=
YOUTUBE_BOT_CLIENT_SECRET=
YOUTUBE_BOT_REFRESH_TOKEN=
YOUTUBE_BOT_CHANNEL_NAME=PlanetCreationsBot
