{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "Standalone bot for the PlanetCreations application",
  "main": "bot.js",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "start": "node bot.js",
    "deploy": "node deploy-commands.js",
    "setup:twitch-bot": "node setupTwitchBotOAuth.js",
    "setup:youtube-bot": "node setupYouTubeBotOAuth.js",
    "sync:stream-bot-credentials": "node syncStreamBotCredentials.js",
    "test:twitch-chat": "node runTwitchChatTest.js",
    "test": "node --test syntax.test.js tasks/streamChatBots.test.js"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "firebase-admin": "^14.2.0",
    "node-cron": "^4.6.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
