rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isLoggedIn() {
      return request.auth != null &&
        !exists(/databases/$(database)/documents/accountDeletionLocks/$(request.auth.uid));
    }
    function accountCanWrite() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid)/moderation/state;
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth != null && (!exists(userPath) || get(userPath).data.get('role', 'user') != 'banned') && (!exists(path) ||
        (get(path).data.get('banned', false) == false &&
        (get(path).data.get('suspendedUntil', null) == null || get(path).data.suspendedUntil <= request.time)));
    }
    match /users/{userId}/moderation/{id} {
      allow read: if isOwner(userId) || isModerator();
      allow write: if accountCanWrite() && (false);
    }
    match /users/{userId}/moderationHistory/{id} {
      allow read: if isOwner(userId) || isModerator();
      allow write: if accountCanWrite() && (false);
    }
    function canInteract(a, b) {
      return a == b || (!exists(/databases/$(database)/documents/users/$(a)/blocks/$(b)) &&
        !exists(/databases/$(database)/documents/users/$(b)/blocks/$(a)));
    }
    match /moderationIndexBlocks/{id} {
      allow read: if isModerator();
      allow write: if false;
    }
    match /moderationIndexState/{id} {
      allow read: if isModerator();
      allow write: if false;
    }
    match /moderationArchiveBlocks/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /moderationArchiveState/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /moderationIndexLocations/{id} {
      allow read, write: if false;
    }
    function isOwner(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isLoggedIn() && request.auth.token.get('role', '') == 'admin';
    }
    function isModerator() {
      return isLoggedIn() && (
        request.auth.token.get('role', '') == 'moderator' ||
        request.auth.token.get('role', '') == 'admin'
      );
    }
    function isInfluencer() {
      return isLoggedIn() && request.auth.token.get('role', '') == 'influencer';
    }
    function communityMemberCan(communityId, permission) {
      let memberPath = /databases/$(database)/documents/communitys/$(communityId)/members/$(request.auth.uid);
      return isLoggedIn() && exists(memberPath) && (
        get(/databases/$(database)/documents/communitys/$(communityId)).data.ownerId == request.auth.uid ||
        get(memberPath).data.get('roles', []).hasAny(['owner']) ||
        get(memberPath).data.get('perms', []).hasAny([permission])
      );
    }
    function communityAllowsSelfJoin(communityId, userId) {
      let communityPath = /databases/$(database)/documents/communitys/$(communityId);
      let invitePath = /databases/$(database)/documents/communitys/$(communityId)/invites/$(userId);
      return get(communityPath).data.get('joinMode', 'open') == 'open' ||
        (exists(invitePath) && canInteract(userId, get(invitePath).data.invitedBy));
    }

    // A server-published, escaped expression is shared with callable validation.
    // A missing or empty policy uses the same conservative baseline as the server.
    function acceptableText(value) {
      let policy = /databases/$(database)/documents/meta/blacklist;
      let baseline = '(^|.*[^a-z0-9_])(child pornography|child porn|rape you|kill yourself|kinderpornografie|kinderpornographie|bring dich um)([^a-z0-9_].*|$)';
      let pattern = exists(policy) && get(policy).data.get('words', []).size() > 0 &&
        get(policy).data.get('pattern', '^a^') != '^a^'
        ? get(policy).data.pattern : baseline;
      return value is string && !value.lower().replace('[​‌‍﻿]', '').matches('(?s)' + pattern);
    }
    function acceptableContent(data) {
      return acceptableText(data.get('title', '')) && acceptableText(data.get('description', '')) &&
        acceptableText(data.get('name', '')) && acceptableText(data.get('bio', '')) &&
        acceptableText(data.get('message', '')) && acceptableText(data.get('content', '')) && acceptableText(data.get('text', '')) && acceptableText(data.get('note', ''));
    }
    // --- Data Validation Functions ---

    function hasNoServerBackupFields(data) {
      return !data.keys().hasAny([
        'backupObjectKey', 'backupStorageProvider', 'backupUrl',
        'backupFileSize', 'backupIsSigned', 'backupSignerUid',
        'backupSignerUsername', 'backupOriginalFileName', 'backupPackageId',
        'backupMediaSetId', 'backupProcessingError', 'backupUpdatedAt',
        'verifiedGameMetadata', 'rideAnalysisObjectKey'
      ]) || (
        data.get('backupObjectKey', null) == null &&
        data.get('backupStorageProvider', null) == null &&
        data.get('backupUrl', null) == null &&
        data.get('backupFileSize', null) == null &&
        data.get('backupIsSigned', false) == false &&
        data.get('backupSignerUid', null) == null &&
        data.get('backupSignerUsername', null) == null &&
        data.get('backupOriginalFileName', null) == null &&
        data.get('backupPackageId', null) == null &&
        data.get('backupMediaSetId', null) == null &&
        data.get('backupProcessingError', null) == null &&
        data.get('backupUpdatedAt', null) == null &&
        data.get('verifiedGameMetadata', null) == null &&
        data.get('rideAnalysisObjectKey', null) == null
      );
    }

    function serverBackupFieldsAreUnchanged(data, existing) {
      return !data.diff(existing).affectedKeys().hasAny([
        'backupObjectKey', 'backupStorageProvider', 'backupUrl',
        'backupFileSize', 'backupIsSigned', 'backupSignerUid',
        'backupSignerUsername', 'backupOriginalFileName', 'backupPackageId',
        'backupMediaSetId', 'backupProcessingError', 'backupUpdatedAt',
        'verifiedGameMetadata', 'rideAnalysisObjectKey'
      ]);
    }

    function hasNoServerCollaborationPublicationFields(data) {
      return !data.keys().hasAny([
        'contributors', 'contributorIds', 'sourceCollaborationId',
        'sourceCollaborationTitle', 'sourceCollaborationVersionId'
      ]);
    }

    function collaborationPublicationFieldsAreUnchanged(data, existing) {
      return !data.diff(existing).affectedKeys().hasAny([
        'contributors', 'contributorIds', 'sourceCollaborationId',
        'sourceCollaborationTitle', 'sourceCollaborationVersionId'
      ]);
    }

    // User-owned display settings. These may hide or add presentation-only
    // rides, but never contain or replace the server-owned verified metadata.
    function isValidParkRidePresentation(data) {
      let presentation = data.get('parkRidePresentation', null);
      return presentation == null || (
        presentation is map &&
        presentation.keys().hasOnly([
          'version', 'areas', 'customRides', 'hiddenRideKeys',
          'rideAreaAssignments', 'rideEfnOverrides', 'rideDisplayNames'
        ]) &&
        presentation.get('version', 1) == 1 &&
        presentation.get('areas', []) is list &&
        presentation.get('areas', []).size() <= 24 &&
        presentation.get('customRides', []) is list &&
        presentation.get('customRides', []).size() <= 100 &&
        presentation.get('hiddenRideKeys', []) is list &&
        presentation.get('hiddenRideKeys', []).size() <= 500 &&
        presentation.get('rideAreaAssignments', {}) is map &&
        presentation.get('rideAreaAssignments', {}).keys().size() <= 500 &&
        presentation.get('rideEfnOverrides', {}) is map &&
        presentation.get('rideEfnOverrides', {}).keys().size() <= 500 &&
        presentation.get('rideDisplayNames', {}) is map &&
        presentation.get('rideDisplayNames', {}).keys().size() <= 500
      );
    }

    // Validiert Creation-Daten bei Create. Erlaubte Spiele kommen aus der
    // Games-Registry (meta/games.gameIds, nur enabled — Admin-Tab "Games");
    // solange das Doc noch nicht existiert, greift die alte Fallback-Liste.
    function validChangelogChange(data, existing) {
      let old = existing.get('changelog', []);
      let next = data.get('changelog', []);
      return next == old || (next is list && next.size() == old.size() + 1 &&
        next[0:old.size()] == old && acceptableText(next[old.size()].get('text', '')));
    }
    function isValidCreationCreate(data) {
      return data.get('moderationWithheld', false) == false && data.get('moderationHolds', {}) == {} && acceptableContent(data) && validChangelogChange(data, {}) && data.keys().hasAll(['title', 'game', 'category', 'userId', 'tags']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             (
               exists(/databases/$(database)/documents/meta/games)
                 ? data.game in get(/databases/$(database)/documents/meta/games).data.gameIds
                 : data.game in ['planet-coaster', 'planet-coaster-2', 'planet-zoo']
             ) &&
             data.category is string && data.category.size() <= 50 &&
             data.userId == request.auth.uid &&
             hasNoServerBackupFields(data) &&
             hasNoServerCollaborationPublicationFields(data) &&
             isValidParkRidePresentation(data) &&
             data.get('eventIds', []).size() == 0 &&
             data.get('eventSubmissions', {}) == {} &&
             data.get('likes', 0) == 0 && data.get('dislikes', 0) == 0 &&
             data.get('views', 0) == 0 && data.get('reportCount', 0) == 0 &&
             data.get('activityScore', 0) == 0 && data.get('activityAt', null) == null &&
             data.get('liveStream', null) == null &&
             (!('description' in data.keys()) || (data.description is string && data.description.size() <= 5000)) &&
             data.tags is list && acceptableText(data.tags.join(' ')) && data.tags.size() > 0 && data.tags.size() <= 20;
    }

    // Validiert Creation-Daten bei Update (verhindert Likes-Manipulation durch normale User)
    function isValidCreationUpdate(data, existing) {
      return data.get('moderationWithheld', false) == existing.get('moderationWithheld', false) && data.get('moderationHolds', {}) == existing.get('moderationHolds', {}) && acceptableContent(data) && validChangelogChange(data, existing) && data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.userId == existing.userId &&
             data.game == existing.game &&
             data.get('likes', 0) == existing.get('likes', 0) &&
             data.get('dislikes', 0) == existing.get('dislikes', 0) &&
             data.get('views', 0) == existing.get('views', 0) &&
             data.get('reportCount', 0) == existing.get('reportCount', 0) &&
             isValidParkRidePresentation(data) &&
             (!('description' in data.keys()) || (data.description is string && data.description.size() <= 5000)) &&
             data.tags is list && acceptableText(data.tags.join(' ')) && data.tags.size() > 0 && data.tags.size() <= 20 &&
             // Activity-Score wird nur serverseitig gepflegt (onCreationActivityScore,
             // Admin SDK umgeht Rules) — Clients dürfen ihn nicht manipulieren.
             data.get('activityScore', 0) == existing.get('activityScore', 0) &&
             data.get('activityAt', null) == existing.get('activityAt', null) &&
             // Live-Status ebenfalls nur serverseitig (goLive/endLive/Sweep
             // verifizieren über die Twitch-/YouTube-API) — sonst könnte ein
             // modifizierter Client sich Live-Badge und Feed-Boost erschleichen.
             data.get('liveStream', null) == existing.get('liveStream', null);
    }

    // Event-Einreichungen werden ausschließlich durch die atomare Callable
    // submitCreationToEvent geschrieben. So kann kein Client die serverseitige
    // Limitprüfung durch direkte Creation-Updates umgehen.
    function eventSubmissionFieldsAreUnchanged(data, existing) {
      return data.get('eventIds', []) == existing.get('eventIds', []) &&
             data.get('eventSubmissions', {}) == existing.get('eventSubmissions', {});
    }

    // Validiert Profile-Daten
    function isValidProfileData(data) {
      return acceptableContent(data) && acceptableText(data.get('username', '')) && (!('username' in data.keys()) || (data.username is string && data.username.size() >= 3 && data.username.size() <= 30)) &&
             (!('bio' in data.keys()) || (data.bio is string && data.bio.size() <= 500));
    }

    // Validiert Community-Daten
    // Keep this reserved root-path list in sync with
    // src/utils/communityRoutes.js. Existing legacy slugs remain editable when
    // unchanged; new and renamed communities must use a free vanity path.
    function isValidCommunitySlug(slug) {
      return slug is string &&
             slug.size() >= 1 && slug.size() <= 100 &&
             slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$') &&
             !(slug in [
               'admin', 'api', 'assets', 'client', 'client-info',
               'collaboration', 'community', 'community-guidelines',
               'communitys', 'create', 'create-community', 'creation',
               'event', 'favicon', 'firebase-messaging-sw', 'impressum',
               'index', 'login', 'manager', 'manifest', 'moderation',
               'privacy', 'profile', 'robots', 'settings', 'share',
               'showcase', 'sitemap', 'terms-of-service'
             ]);
    }

    function isValidCommunityData(data) {
      return acceptableContent(data) && data.keys().hasAll(['name', 'ownerId']) &&
             data.name is string && data.name.size() >= 3 && data.name.size() <= 100 &&
             (!('description' in data.keys()) || (data.description is string && data.description.size() <= 2000)) &&
             (!('membersOnlyInfoPage' in data.keys()) || data.membersOnlyInfoPage is bool) &&
             (!('isPartner' in data.keys()) || data.isPartner is bool);
    }

    // --- Rules for Collections ---

    match /events/{eventId} {
      allow read: if true;

      // ✅ FIX: Separated 'write' into specific create, update, and delete rules.
      // This ensures the correct variables are used for each operation.
      allow create: if accountCanWrite() && (isLoggedIn() && acceptableContent(request.resource.data) &&
          request.resource.data.creatorId == request.auth.uid &&
          !request.resource.data.keys().hasAny(['voteSchemaVersion', 'autoPostedSubmissions']) &&
          (communityMemberCan(request.resource.data.communityId, 'createEvents') || isModerator()));
      allow update: if accountCanWrite() && (isLoggedIn() && acceptableContent(request.resource.data) &&
          request.resource.data.communityId == resource.data.communityId &&
          request.resource.data.get('voteSchemaVersion', null) == resource.data.get('voteSchemaVersion', null) &&
          request.resource.data.get('autoPostedSubmissions', {}) == resource.data.get('autoPostedSubmissions', {}) &&
          request.resource.data.creatorId == resource.data.creatorId && (
          communityMemberCan(resource.data.communityId, 'manageEvents') ||
          isModerator() ||
          (resource.data.creatorId == request.auth.uid &&
           communityMemberCan(resource.data.communityId, 'createEvents'))
      ));
      allow delete: if accountCanWrite() && (isLoggedIn() && (
          communityMemberCan(resource.data.communityId, 'manageEvents') ||
          isModerator() ||
          (resource.data.creatorId == request.auth.uid &&
           communityMemberCan(resource.data.communityId, 'createEvents'))
      ));
      
      match /voters/{userId} {
        allow read: if true;
        allow create: if accountCanWrite() && (false);
        allow delete: if accountCanWrite() && (communityMemberCan(
          get(/databases/$(database)/documents/events/$(eventId)).data.communityId,
          'manageEvents'
        ) || isModerator());
      }
    }

    match /events/{eventId}/ballots/{userId} {
      allow read: if isLoggedIn() && (isOwner(userId) || isModerator());
      allow write: if accountCanWrite() && (false);
    }
    match /events/{eventId}/voteTotals/{shardId} {
      allow read: if true;
      allow write: if accountCanWrite() && (false);
    }

    match /communitys/{communityId} {
      allow read: if true;
      allow create: if accountCanWrite() && ((isInfluencer() || isModerator()) &&
        isValidCommunityData(request.resource.data) &&
        !exists(/databases/$(database)/documents/accountDeletionLocks/$(request.resource.data.ownerId)) &&
        isValidCommunitySlug(request.resource.data.get('slug', '')) &&
        (isAdmin() || !('isPartner' in request.resource.data.keys())));
      allow update: if accountCanWrite() && (isLoggedIn() &&
        isValidCommunityData(request.resource.data) &&
        (request.resource.data.ownerId == resource.data.ownerId ||
          !exists(/databases/$(database)/documents/accountDeletionLocks/$(request.resource.data.ownerId))) &&
        (
          request.resource.data.get('slug', '') == resource.data.get('slug', '') ||
          isValidCommunitySlug(request.resource.data.get('slug', ''))
        ) &&
        // Der Partnerstatus ist eine plattformweite Auszeichnung und darf weder
        // von Community-Ownern noch von Community-Moderatoren verändert werden.
        (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPartner'])) &&
        (
          get(/databases/$(database)/documents/communitys/$(communityId)).data.ownerId == request.auth.uid ||
          isAdmin() ||
          (
            communityMemberCan(communityId, 'manageShowcases') &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['showcaseGroups'])
          )
        ));
      allow delete: if accountCanWrite() && (isLoggedIn() && (get(/databases/$(database)/documents/communitys/$(communityId)).data.ownerId == request.auth.uid || isAdmin()));

      match /members/{userId} {
        allow read: if true;
        // Beim Beitreten darf man sich NUR mit dem Standard-Rang eintragen. Der
        // Community-Owner (seedet beim Erstellen 'owner') und Staff/Site-Mods dürfen
        // beliebige Rollen setzen. Verhindert, dass ein normales Mitglied sich selbst
        // per roles:['owner'] zu Community-Staff hochstuft (isCommunityStaff).
        allow create: if accountCanWrite() && (isLoggedIn() && isOwner(userId) &&
          !request.resource.data.keys().hasAny(['perms']) && (
            (
              request.resource.data.roles == [get(/databases/$(database)/documents/communitys/$(communityId)).data.get('defaultRankName', 'member').lower()] &&
              communityAllowsSelfJoin(communityId, userId)
            ) ||
            get(/databases/$(database)/documents/communitys/$(communityId)).data.ownerId == request.auth.uid ||
            communityMemberCan(communityId, 'manageMembers') ||
            isModerator()
        ));
        allow delete: if accountCanWrite() && (isLoggedIn() && (
          isOwner(userId) ||
          get(/databases/$(database)/documents/communitys/$(communityId)).data.ownerId == request.auth.uid ||
          isAdmin() ||
          (
            (communityMemberCan(communityId, 'manageMembers') || isModerator()) &&
            !resource.data.roles.hasAny(['owner', 'moderator'])
          )
        ));
        // Owner/Admins dürfen alle Rollen verwalten. Community- und Site-Moderatoren
        // dürfen nur normale Mitglieder/Ränge bearbeiten, nicht Owner oder Moderator.
        // Ein Mitglied darf sein eigenes Doc nur ändern, solange roles unverändert bleibt.
        allow update: if accountCanWrite() && (isLoggedIn() &&
          request.resource.data.get('perms', []) == resource.data.get('perms', []) && (
            get(/databases/$(database)/documents/communitys/$(communityId)).data.ownerId == request.auth.uid ||
            isAdmin() ||
            (
              userId != request.auth.uid &&
              (communityMemberCan(communityId, 'manageMembers') || isModerator()) &&
              !resource.data.roles.hasAny(['owner', 'moderator']) &&
              !request.resource.data.roles.hasAny(['owner', 'moderator'])
            ) ||
            (isOwner(userId) && request.resource.data.roles == resource.data.roles)
        ));
      }
      match /joinRequests/{userId} {
        allow read: if isLoggedIn() &&
          (
            isOwner(userId) ||
            communityMemberCan(communityId, 'manageJoinRequests') ||
            isModerator()
          );
        allow create: if accountCanWrite() && (isLoggedIn() && isOwner(userId) &&
          get(/databases/$(database)/documents/communitys/$(communityId)).data.get('joinMode', 'open') == 'application' &&
          request.resource.data.keys().hasOnly([
            'userId', 'username', 'message', 'status', 'createdAt'
          ]) &&
          request.resource.data.userId == userId &&
          request.resource.data.status == 'pending' &&
          request.resource.data.username is string &&
          request.resource.data.username.size() <= 30 &&
          request.resource.data.username ==
            get(/databases/$(database)/documents/profiles/$(userId)).data.username &&
          acceptableText(request.resource.data.message) && request.resource.data.message is string &&
          request.resource.data.message.size() <= 1000 &&
          (
            get(/databases/$(database)/documents/communitys/$(communityId)).data.get('allowApplicationMessage', false) == true ||
            request.resource.data.message == ''
          ) &&
          !exists(/databases/$(database)/documents/communitys/$(communityId)/members/$(userId)) &&
          request.resource.data.createdAt == request.time);
        allow update: if accountCanWrite() && (false);
        allow delete: if accountCanWrite() && (isLoggedIn() &&
          (
            isOwner(userId) ||
            communityMemberCan(communityId, 'manageJoinRequests') ||
            isModerator()
          ));
      }
      match /invites/{userId} {
        allow read: if isLoggedIn() &&
          (
            isOwner(userId) ||
            communityMemberCan(communityId, 'manageInvitations') ||
            isModerator()
          );
        allow create: if accountCanWrite() && (isLoggedIn() &&
          (communityMemberCan(communityId, 'manageInvitations') || isModerator()) &&
          request.resource.data.keys().hasOnly([
            'userId', 'communityId', 'username', 'invitedBy', 'invitedAt'
          ]) &&
          request.resource.data.userId == userId &&
          request.resource.data.communityId == communityId &&
          request.resource.data.invitedBy == request.auth.uid && canInteract(request.auth.uid, userId) &&
          request.resource.data.username is string &&
          request.resource.data.username ==
            get(/databases/$(database)/documents/profiles/$(userId)).data.username &&
          !exists(/databases/$(database)/documents/communitys/$(communityId)/members/$(userId)) &&
          request.resource.data.invitedAt == request.time);
        allow update: if accountCanWrite() && (false);
        allow delete: if accountCanWrite() && (isLoggedIn() &&
          (
            isOwner(userId) ||
            communityMemberCan(communityId, 'manageInvitations') ||
            isModerator()
          ));
      }
      match /private/{documentId} {
        allow read: if false;
        allow write: if accountCanWrite() && (false);
      }
      match /creations/{creationId} {
        allow read: if true;
        // Nur eigene Creations dürfen in Communitys eingehängt werden
        // (Moderatoren dürfen fremde, z. B. beim Bearbeiten im Auftrag).
        allow create: if accountCanWrite() && (isLoggedIn() &&
            request.resource.data.keys().hasOnly(['userId', 'creationId', 'linkedAt']) &&
            request.resource.data.get('creationId', creationId) == creationId &&
            request.resource.data.userId == request.auth.uid &&
            ((communityMemberCan(communityId, 'addCreations') &&
              getAfter(/databases/$(database)/documents/creations/$(creationId)).data.userId == request.auth.uid) ||
             communityMemberCan(communityId, 'manageCreations') ||
             communityMemberCan(communityId, 'manageShowcases') || isModerator()));
        // Owner der Creation darf sein Link-Doc entfernen (Creation aus der
        // Community nehmen) und sich einmalig für das Showcase bewerben —
        // dabei dürfen nur die Bewerbungsfelder geändert werden.
        allow update: if accountCanWrite() && (isLoggedIn() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['showcaseModerationWithheld']) &&
          (!resource.data.get('showcaseModerationWithheld', false)) &&
          (request.resource.data.get('showcaseGroupId', null) == null ||
            !exists(/databases/$(database)/documents/showcaseModeration/$(request.resource.data.showcaseGroupId)) ||
            !get(/databases/$(database)/documents/showcaseModeration/$(request.resource.data.showcaseGroupId)).data.get('withheld', false)) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'discordMessageId', 'discordChannelId', 'discordShowcaseMessageId',
            'discordShowcaseChannelId', 'reactionCount', 'userId', 'creationId', 'linkedAt'
          ]) && (
            communityMemberCan(communityId, 'manageCreations') ||
            communityMemberCan(communityId, 'manageShowcases') ||
            isModerator() ||
            (
                resource.data.userId == request.auth.uid &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['appliedForShowcase', 'appliedAt']) &&
                request.resource.data.appliedForShowcase == true &&
                communityMemberCan(communityId, 'applyShowcase') &&
                !('appliedForShowcase' in resource.data && resource.data.appliedForShowcase == true) &&
                // Bereits geshowcaste Creations können sich nicht erneut bewerben
                !('showcaseVideoUrl' in resource.data && resource.data.showcaseVideoUrl != null)
            )
        ));
        allow delete: if accountCanWrite() && (isLoggedIn() && (
          communityMemberCan(communityId, 'manageCreations') ||
          isModerator() ||
          resource.data.userId == request.auth.uid
        ));
      }
    }

    match /creations/{creationId} {
      allow read: if resource.data.get('moderationWithheld', false) == false || isModerator() || isOwner(resource.data.userId);
      allow create: if accountCanWrite() && (isLoggedIn() &&
          request.resource.data.userId == request.auth.uid &&
          isValidCreationCreate(request.resource.data));
      // Views and reaction totals are server-authoritative.
      allow update: if accountCanWrite() && ((isLoggedIn() && (
          !(isOwner(resource.data.userId) && resource.data.get('moderationWithheld', false)) &&
          serverBackupFieldsAreUnchanged(request.resource.data, resource.data) &&
          collaborationPublicationFieldsAreUnchanged(request.resource.data, resource.data) &&
          eventSubmissionFieldsAreUnchanged(request.resource.data, resource.data) &&
          ((isOwner(resource.data.userId) && isValidCreationUpdate(request.resource.data, resource.data)) ||
          (isModerator() && isValidCreationUpdate(request.resource.data, resource.data)))
       )));
      allow delete: if accountCanWrite() && (isLoggedIn() && (
        isModerator() ||
        (
          isOwner(resource.data.userId) &&
          resource.data.get('sourceCollaborationId', null) == null
        )
      ));

      match /votes/{userId} {
        allow read: if true;
        allow write: if accountCanWrite() && (false);
      }
      
      // Nur lesen: Der Client schreibt unter creations ausschließlich die
      // votes-Subcollection (eigene strenge Regel oben). Ein Wildcard-write
      // würde die votes-Regel aushebeln und beliebige Subcollections öffnen.
      match /{subcollection}/{docId} {
        allow read: if true;
      }
    }

    // Collection-Group-Queries auf votes (EventDetailPage: "welche Creations habe
    // ich in diesem Event schon gevotet?"). Die Pfad-Regel oben greift für
    // collectionGroup() NICHT — ohne diese Regel liefert die Query permission-denied.
    // votes existieren nur unter creations und sind dort ohnehin öffentlich lesbar.
    match /{path=**}/votes/{voteId} {
      allow read: if true;
    }

    // Invitation hub: an authenticated user can query only invitation documents
    // whose userId field is their own UID.
    match /{path=**}/invites/{userId} {
      allow read: if isLoggedIn() && resource.data.userId == request.auth.uid;
    }

    // Größenbasierte State-/Shard-Indexe. Locations bleiben absichtlich ohne
    // Client-Regel und sind damit ausschließlich über das Admin SDK erreichbar.
    match /searchIndexState/{gameId} {
      allow read: if true;
      allow write: if accountCanWrite() && (false);
    }
    match /searchIndexShards/{shardId} {
      allow read: if true;
      allow write: if accountCanWrite() && (false);
    }
    match /communitySearchIndexState/{communityId} {
      allow read: if true;
      allow write: if accountCanWrite() && (false);
    }
    match /communitySearchIndexShards/{shardId} {
      allow read: if true;
      allow write: if accountCanWrite() && (false);
    }
    match /userSearchIndexState/{scopeId} {
      allow read: if true;
      allow write: if accountCanWrite() && (false);
    }
    match /userSearchIndexShards/{shardId} {
      allow read: if true;
      allow write: if accountCanWrite() && (false);
    }
    function canReadShowcase(showcaseId) {
      let path = /databases/$(database)/documents/showcaseModeration/$(showcaseId);
      return !exists(path) || !get(path).data.get('withheld', false) || isModerator() || communityMemberCan(get(path).data.communityId, 'manageModerationAppeals') ||
        (isLoggedIn() && get(/databases/$(database)/documents/communitys/$(get(path).data.communityId)).data.ownerId == request.auth.uid);
    }
    match /showcaseModeration/{showcaseId} {
      allow read: if canReadShowcase(showcaseId);
      allow write: if accountCanWrite() && (false);
    }
    match /showcaseIndexState/{showcaseId} {
      allow read: if canReadShowcase(showcaseId);
      allow write: if accountCanWrite() && (false);
    }
    match /showcaseIndexShards/{shardId} {
      allow read: if canReadShowcase(resource.data.i);
      allow write: if accountCanWrite() && (false);
    }

    // Öffentlicher, rückwärts verketteter YouTube-Videoindex. Ausschließlich die
    // WebSub-/Backfill-Functions schreiben State und Shards über das Admin SDK.
    match /youtubeVideoIndexState/{documentId} {
      allow read: if true;
      allow write: if accountCanWrite() && (false);
    }

    match /youtubeVideoIndexShards/{shardId} {
      allow read: if true;
      allow write: if accountCanWrite() && (false);
    }

    // Bug-Reports: eingeloggte Nutzer melden, nur Admins lesen/verwalten.
    match /bugReports/{reportId} {
      allow create: if accountCanWrite() && (isLoggedIn() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'open' &&
          request.resource.data.description is string &&
          request.resource.data.description.size() >= 10 &&
          request.resource.data.description.size() <= 3000);
      allow read: if isAdmin();
      allow update, delete: if accountCanWrite() && isAdmin();
    }

    match /profiles/{userId} {
      allow read: if true;
      // role wird serverseitig von setCustomClaims (Admin SDK, umgeht Rules) gepflegt.
      // Clients dürfen bei create nur 'user' setzen und role beim update NICHT ändern —
      // sonst könnte man sich selbst zu admin/moderator machen (ProtectedRoute vertraut
      // profile.role fürs UI-Gating).
      allow create: if accountCanWrite() && (isOwner(userId) && isValidProfileData(request.resource.data) &&
          request.resource.data.get('followers', []) == [] &&
          (!('role' in request.resource.data.keys()) || request.resource.data.role == 'user'));
      allow update: if
          accountCanWrite() && (((isOwner(userId) || isAdmin()) && isValidProfileData(request.resource.data) &&
           request.resource.data.get('followers', []) == resource.data.get('followers', []) &&
           (isAdmin() || request.resource.data.get('role', 'user') == resource.data.get('role', 'user')))
          ||
          // Fremdes Profil: eingeloggte Nutzer dürfen sich NUR selbst in die
          // followers-Liste eintragen/austragen (Follow/Unfollow) — nichts anderes.
          (isLoggedIn() && request.auth.uid != userId &&
           !exists(/databases/$(database)/documents/accountDeletionLocks/$(userId)) &&
           request.resource.data.get('followers', []) is list &&
           request.resource.data.get('followers', []).size() == request.resource.data.get('followers', []).toSet().size() &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers']) && (
             (canInteract(request.auth.uid, userId) && request.auth.uid in request.resource.data.get('followers', []) &&
              !(request.auth.uid in resource.data.get('followers', [])) &&
              request.resource.data.get('followers', []).hasAll(resource.data.get('followers', [])) &&
              request.resource.data.get('followers', []).size() == resource.data.get('followers', []).size() + 1) ||
             (!(request.auth.uid in request.resource.data.get('followers', [])) &&
              request.auth.uid in resource.data.get('followers', []) &&
              resource.data.get('followers', []).hasAll(request.resource.data.get('followers', [])) &&
              request.resource.data.get('followers', []).size() == resource.data.get('followers', []).size() - 1)
           )));
      allow delete: if accountCanWrite() && (false); // Account deletion uses deleteOwnAccount/deleteUserAndContent.

      match /communityMemberships/{communityId} {
        allow read: if true;
        allow create: if accountCanWrite() && (isOwner(userId) &&
          existsAfter(/databases/$(database)/documents/communitys/$(communityId)/members/$(userId)) &&
          request.resource.data.roles ==
            getAfter(/databases/$(database)/documents/communitys/$(communityId)/members/$(userId)).data.roles);
        allow update: if accountCanWrite() && (isAdmin());
        allow delete: if accountCanWrite() && ((isOwner(userId) &&
          !existsAfter(/databases/$(database)/documents/communitys/$(communityId)/members/$(userId))) ||
          isAdmin());
      }
    }

    match /users/{userId} {
      match /blocks/{targetUserId} {
        allow read: if isOwner(userId);
        allow write: if accountCanWrite() && (false);
      }
      allow read: if isOwner(userId) || isAdmin();
      // Discord identity and OAuth fields are server-authoritative. Clients must
      // never be able to forge a Discord id/guild list or write provider tokens.
      allow create: if accountCanWrite() && (isOwner(userId) &&
          request.resource.data.role == 'user' &&
          request.resource.data.get('strikes', 0) == 0 &&
          request.resource.data.get('reportCount', 0) == 0 &&
          !request.resource.data.keys().hasAny([
            'discordId',
            'discordUsername',
            'discordGuilds',
            'discordLinkedAt',
            'discordRefreshToken'
          ]));
      // reportCount wird serverseitig vom onReportCreated-Trigger gepflegt, nicht
      // mehr vom Client (verhindert Zähler-Manipulation/Harassment).
      allow update: if accountCanWrite() && ((
          isOwner(userId) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.get('strikes', 0) == resource.data.get('strikes', 0) &&
          request.resource.data.get('reportCount', 0) == resource.data.get('reportCount', 0) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'discordId',
            'discordUsername',
            'discordGuilds',
            'discordLinkedAt',
            'discordRefreshToken'
          ])
        ) || isAdmin());
      allow delete: if accountCanWrite() && (isOwner(userId) || isAdmin());

      // Notification hub: single capped inbox doc (users/{uid}/meta/inbox) with
      // items + unreadCount + prefs + pushTokens. Server (admin) writes items on
      // fan-out; the owner writes prefs/pushTokens/mark-read/clear.
      match /meta/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if accountCanWrite() && ((isOwner(userId) || isAdmin()) && !request.resource.data.keys().hasAny(['deliveries']));
        allow update: if accountCanWrite() && ((isOwner(userId) || isAdmin()) && request.resource.data.get('deliveries', {}) == resource.data.get('deliveries', {}));
        allow delete: if accountCanWrite() && (docId != 'inbox' && (isOwner(userId) || isAdmin()));
      }
      match /following/{creationId} {
        allow read: if isOwner(userId);
        allow write: if accountCanWrite() && (isOwner(userId));
      }
      match /reportedItems/{creationId} {
        allow read: if isOwner(userId);
        allow write: if accountCanWrite() && (false);
      }
    }

    // OAuth state, refresh tokens, provider-to-user mappings and distributed
    // rate-limit counters are exclusively managed through Cloud Functions.
    match /oauthStates/{stateHash} {
      allow read: if false;
        allow write: if accountCanWrite() && (false);
    }
    // Stream sessions contain server-verified platform state and drive atomic
    // creation switches. Desktop devices receive a compact projection through
    // their existing protected client queue; no client may forge session state.
    match /liveSessions/{userId} {
      allow read: if false;
        allow write: if accountCanWrite() && (false);
    }
    // Atomic, server-owned channel locks prevent two accounts or modified
    // clients from attaching PlanetCreations to the same live channel.
    match /liveChannelClaims/{claimId} {
      allow read: if false;
        allow write: if accountCanWrite() && (false);
    }
    match /privateOAuthCredentials/{userId} {
      allow read: if false;
        allow write: if accountCanWrite() && (false);
    }
    match /discordAccountLinks/{discordId} {
      allow read: if false;
        allow write: if accountCanWrite() && (false);
    }
    match /securityRateLimits/{limitId} {
      allow read: if false;
        allow write: if accountCanWrite() && (false);
    }

    // Device-specific direct-install queues are written only by callable Cloud
    // Functions. The owning account can read its queues; clients cannot forge,
    // retarget, or remove commands directly.
    match /clientInstallQueues/{userId}/clients/{clientId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if accountCanWrite() && (false);
    }

    match /usernames/{username} {
      allow read: if true;
      // Bindet die Reservierung an die eigene Konto-E-Mail (verhindert
      // Squatting mit fremden/erfundenen E-Mails). Registrierung ist nur
      // per E-Mail/Passwort möglich, token.email ist also immer gesetzt.
      allow create: if accountCanWrite() && (isLoggedIn() &&
          request.resource.data.keys().hasOnly(['email']) &&
          request.resource.data.email == request.auth.token.email.lower());
    }
    
    // Per-creation followers (creationFollowers/{creationId}/followers/{uid}) —
    // drives "notify me when this creation updates". Each user manages only their
    // own follow doc; server fan-out reads these with admin (bypasses rules).
    match /creationFollowers/{creationId}/followers/{followerId} {
        allow read: if true;
        allow create, delete: if accountCanWrite() && (isLoggedIn() && isOwner(followerId));
    }

    match /dlcs/{gameId} {
        allow read: if isLoggedIn();
        allow write: if accountCanWrite() && (isAdmin());
    }
    match /categories/{gameId} {
      allow read: if true;
      allow write: if accountCanWrite() && (isAdmin());
    }
    match /tags/{tagId} {
      allow read: if true;
      allow write: if accountCanWrite() && (isModerator());
    }
    match /mods/{modId} {
      allow read: if true;
      allow write: if accountCanWrite() && (isModerator());
    }
    match /meta/{docId} {
        allow read: if true;
        allow write: if accountCanWrite() && (docId != 'blacklist' && isModerator());
    }
    match /contentReviews/{caseId} {
      allow read: if isModerator();
      allow write: if accountCanWrite() && (false);
    }
    match /users/{userId}/moderationNotices/{caseId} {
      allow read: if isOwner(userId) || isModerator();
      allow write: if accountCanWrite() && (false);
    }
    match /reports/{reportId} {
      allow create: if accountCanWrite() && (isLoggedIn() &&
          request.resource.data.keys().hasOnly([
            'markerId', 'reason', 'reporterId', 'targetId', 'targetPath',
            'targetTitle', 'targetType', 'timestamp'
          ]) &&
          request.resource.data.reporterId == request.auth.uid &&
          request.resource.data.targetId is string &&
          request.resource.data.targetId.size() > 0 &&
          request.resource.data.targetId.size() <= 500 &&
          request.resource.data.targetType in [
            'creation', 'user', 'community', 'event', 'showcase', 'collaboration'
          ] &&
          request.resource.data.get('targetTitle', '') is string &&
          request.resource.data.get('targetTitle', '').size() <= 500 &&
          request.resource.data.get('targetPath', '') is string &&
          request.resource.data.get('targetPath', '').size() <= 1000 &&
          request.resource.data.get('markerId', '') is string &&
          request.resource.data.get('markerId', '').size() <= 1000 &&
          request.resource.data.timestamp == request.time &&
          request.resource.data.reason is string &&
          request.resource.data.reason.size() > 0 &&
          request.resource.data.reason.size() <= 2000);
      allow list, get: if isModerator();
      allow update, delete: if accountCanWrite() && (isModerator());
    }
    match /applications/{userId} {
      allow read: if isAdmin();
      allow delete: if accountCanWrite() && isAdmin();
      allow create: if accountCanWrite() && (isLoggedIn() && isOwner(userId));
    }

    // --- Collaborations ---
    function isCollaborationMember(collaborationId) {
      let memberPath = /databases/$(database)/documents/collaborations/$(collaborationId)/members/$(request.auth.uid);
      return isLoggedIn() && exists(memberPath);
    }
    function isCollaborationOwner(collaborationId) {
      let collaborationPath = /databases/$(database)/documents/collaborations/$(collaborationId);
      return isLoggedIn() &&
        get(collaborationPath).data.get('ownerId', '') == request.auth.uid;
    }
    function isCollaborationActive(collaborationId) {
      return get(/databases/$(database)/documents/collaborations/$(collaborationId))
        .data.get('status', 'active') == 'active';
    }
    // Collaboration owner OR site moderator/admin
    function isCollaborationOwnerOrMod(collaborationId) {
      return isCollaborationOwner(collaborationId) || isModerator();
    }
    match /collaborations/{collaborationId} {
      // Lesen/Listen nur, wenn Mitglied/Owner/Mod. Dadurch sind nur die eigenen
      // Collaborations abfragbar (ownerId==uid bzw. memberIds array-contains uid) —
      // kein Blanket-list mehr, das inviteCodes aller Collaborations preisgibt.
      // Der Beitritt per Code läuft über die Cloud Function joinCollaborationByInviteCode.
      allow get: if isLoggedIn() && (
        isCollaborationMember(collaborationId) ||
        resource.data.get('ownerId', '') == request.auth.uid ||
        request.auth.uid in resource.data.get('memberIds', []) ||
        isModerator()
      );
      // Collection queries cannot prove access through a per-document member
      // subcollection lookup. The client queries by ownerId/memberIds, so keep
      // list authorization on those denormalized fields only.
      allow list: if isLoggedIn() && (
        resource.data.get('ownerId', '') == request.auth.uid ||
        request.auth.uid in resource.data.get('memberIds', []) ||
        isModerator()
      );
      // Nur über die createCollaboration Cloud Function (Admin-SDK umgeht Rules):
      // verhindert gefälschte ownerId/memberIds und ungeprüfte Docs.
      allow create: if accountCanWrite() && (false);
      // Settings, build locks, invite-code rotation, membership indexes and
      // version pointers are all written by callable Functions.
      allow update: if accountCanWrite() && (false);
      // Deletion is server-only so R2 objects are removed before metadata.
      allow delete: if accountCanWrite() && (false);

      match /members/{userId} {
        allow read: if isCollaborationMember(collaborationId) || isModerator();
        // Member-Docs entstehen NUR über Cloud Functions (createCollaboration,
        // joinCollaborationByInviteCode, respondToCollaborationInvitation). Direkter
        // Client-Create ist verboten — sonst könnte sich jeder Eingeloggte selbst
        // mit role:'owner' in eine beliebige Collaboration schreiben.
        allow create: if accountCanWrite() && (false);
        allow update, delete: if accountCanWrite() && (false);
      }

      match /applications/{applicantId} {
        // Owner/Mitglieder sehen alle Bewerbungen; der Bewerber sieht seine eigene.
        allow read: if isCollaborationMember(collaborationId) || isModerator() ||
          (isLoggedIn() && applicantId == request.auth.uid);
        // Bewerbungen entstehen/ändern sich NUR über Cloud Functions
        // (applyToCollaboration, respondToCollaborationApplication).
        allow create, update: if accountCanWrite() && (false);
        // Owner/Mods dürfen aufräumen (z. B. beim Löschen der Collaboration).
        allow delete: if accountCanWrite() && (isCollaborationOwnerOrMod(collaborationId) || isModerator());
      }

      match /files/{fileId} {
        allow read: if isCollaborationMember(collaborationId) || isModerator();
        // File/version metadata contains private R2 object keys and is written only
        // by finalizeCollaborationVersion after validating the signed package.
        allow create, update: if accountCanWrite() && (false);
        allow delete: if accountCanWrite() && (false);

        match /versions/{versionId} {
          allow read: if isCollaborationMember(collaborationId) || isModerator();
          allow create, update: if accountCanWrite() && (false);
          allow delete: if accountCanWrite() && (false);
        }
      }

      match /comments/{commentId} {
        allow read: if isCollaborationMember(collaborationId) || isModerator();
        allow create: if accountCanWrite() && (acceptableContent(request.resource.data) && isCollaborationActive(collaborationId) &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['authorId', 'authorUsername', 'authorAvatarUrl', 'content', 'fileId', 'parentId', 'createdAt', 'updatedAt']) &&
          request.resource.data.content is string && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 5000 &&
          (isCollaborationMember(collaborationId) || isModerator()));
        allow update: if accountCanWrite() && (acceptableContent(request.resource.data) && isCollaborationActive(collaborationId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'updatedAt']) &&
          request.resource.data.content is string && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 5000 &&
          isLoggedIn() && (resource.data.get('authorId', resource.data.get('userId', '')) == request.auth.uid || isModerator()));
        // Completed/published workspaces remain readable but are immutable.
        allow delete: if accountCanWrite() && (isCollaborationActive(collaborationId) && (
          isCollaborationOwnerOrMod(collaborationId) ||
          (isLoggedIn() && resource.data.get('authorId', resource.data.get('userId', '')) == request.auth.uid) ||
          isModerator()
        ));
      }

      match /invitations/{inviteId} {
        // Deprecated invite copies are no longer part of the client contract.
        allow read: if false;
        allow write: if accountCanWrite() && (false);
      }

      // Todo items
      match /todos/{todoId} {
        allow read: if isCollaborationMember(collaborationId) || isModerator();
        allow create: if accountCanWrite() && (request.resource.data.createdBy == request.auth.uid && acceptableContent(request.resource.data) && isCollaborationActive(collaborationId) &&
          (isCollaborationMember(collaborationId) || isModerator()));
        allow update: if accountCanWrite() && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy','createdByUsername','createdAt']) && acceptableContent(request.resource.data) && isCollaborationActive(collaborationId) &&
          (isCollaborationMember(collaborationId) || isModerator()));
        allow delete: if accountCanWrite() && (isCollaborationActive(collaborationId) && (
          isCollaborationOwnerOrMod(collaborationId) ||
          (isLoggedIn() && resource.data.createdBy == request.auth.uid) ||
          isModerator()
        ));
      }

      // Work sessions (build history)
      match /workSessions/{sessionId} {
        allow read: if isCollaborationMember(collaborationId) || isModerator();
        allow create: if accountCanWrite() && (acceptableContent(request.resource.data) && isCollaborationActive(collaborationId) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['fileId', 'fileName', 'userId', 'username', 'note', 'startedAt', 'endedAt', 'durationMinutes']) &&
          request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 5000 &&
          (isCollaborationMember(collaborationId) || isModerator()));
        allow update: if accountCanWrite() && (acceptableContent(request.resource.data) && isCollaborationActive(collaborationId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endedAt', 'durationMinutes', 'note']) &&
          isLoggedIn() && resource.data.userId == request.auth.uid);
        allow delete: if accountCanWrite() && (isCollaborationActive(collaborationId) &&
          (isCollaborationOwnerOrMod(collaborationId) || isModerator()));
      }

      // Upload entries (changelog history)
      match /uploads/{uploadId} {
        allow read: if isCollaborationMember(collaborationId) || isModerator();
        allow create: if accountCanWrite() && (false);
        allow delete: if accountCanWrite() && (isCollaborationActive(collaborationId) &&
          (isCollaborationOwnerOrMod(collaborationId) || isModerator()));
      }
    }

    // Deprecated per-user invite copies are replaced by the standard inbox and
    // server-only collaborationInvitationGrants.
    match /users/{userId}/collaborationInvites/{inviteId} {
      allow read: if false;
        allow write: if accountCanWrite() && (false);
    }

    match /collaborationInvitationGrants/{grantId} {
      allow read: if false;
        allow write: if accountCanWrite() && (false);
    }
  }
}
