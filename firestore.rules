rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isLoggedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function isAdmin() {
      return isLoggedIn() && request.auth.token.role == 'admin';
    }
    function isModerator() {
      return isLoggedIn() && (request.auth.token.role == 'moderator' || request.auth.token.role == 'admin');
    }
    function isInfluencer() {
      return isLoggedIn() && request.auth.token.role == 'influencer';
    }
    function isCommunityStaff(communityId) {
      let memberPath = /databases/$(database)/documents/communitys/$(communityId)/members/$(request.auth.uid);
      return isLoggedIn() && exists(memberPath) && get(memberPath).data.roles.hasAny(['owner', 'moderator']);
    }

    // --- Data Validation Functions ---

    // Validiert Creation-Daten bei Create
    function isValidCreationCreate(data) {
      return data.keys().hasAll(['title', 'game', 'category', 'userId']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.game in ['planet-coaster', 'planet-coaster-2', 'planet-zoo'] &&
             data.category is string && data.category.size() <= 50 &&
             data.userId == request.auth.uid &&
             (!('likes' in data.keys()) || data.likes == 0) &&
             (!('description' in data.keys()) || (data.description is string && data.description.size() <= 5000)) &&
             (!('tags' in data.keys()) || (data.tags is list && data.tags.size() <= 20));
    }

    // Validiert Creation-Daten bei Update (verhindert Likes-Manipulation durch normale User)
    function isValidCreationUpdate(data, existing) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.userId == existing.userId &&
             data.game == existing.game &&
             (!('description' in data.keys()) || (data.description is string && data.description.size() <= 5000)) &&
             (!('tags' in data.keys()) || (data.tags is list && data.tags.size() <= 20));
    }

    // Validiert Profile-Daten
    function isValidProfileData(data) {
      return (!('username' in data.keys()) || (data.username is string && data.username.size() >= 3 && data.username.size() <= 30)) &&
             (!('bio' in data.keys()) || (data.bio is string && data.bio.size() <= 500));
    }

    // Validiert Community-Daten
    function isValidCommunityData(data) {
      return data.keys().hasAll(['name', 'ownerId']) &&
             data.name is string && data.name.size() >= 3 && data.name.size() <= 100 &&
             (!('description' in data.keys()) || (data.description is string && data.description.size() <= 2000));
    }

    // --- Rules for Collections ---

    match /events/{eventId} {
      allow read: if true;

      // ✅ FIX: Separated 'write' into specific create, update, and delete rules.
      // This ensures the correct variables are used for each operation.
      allow create: if isLoggedIn() && (isCommunityStaff(request.resource.data.communityId) || isModerator());
      allow update: if isLoggedIn() && (isCommunityStaff(resource.data.communityId) || isModerator());
      allow delete: if isLoggedIn() && (isCommunityStaff(resource.data.communityId) || isModerator());
      
      match /voters/{userId} {
        allow read: if true;
        allow create: if isOwner(userId);
        allow delete: if isCommunityStaff(get(/databases/$(database)/documents/events/$(eventId)).data.communityId) || isModerator();
      }
    }

    match /communitys/{communityId} {
      allow read: if true;
      allow create: if (isInfluencer() || isModerator()) && isValidCommunityData(request.resource.data);
      allow update: if isLoggedIn() && (get(/databases/$(database)/documents/communitys/$(communityId)).data.ownerId == request.auth.uid || isAdmin());
      allow delete: if isLoggedIn() && (get(/databases/$(database)/documents/communitys/$(communityId)).data.ownerId == request.auth.uid || isAdmin());

      match /members/{userId} {
        allow read: if true;
        // Beim Beitreten darf man sich NUR mit dem Standard-Rang eintragen. Der
        // Community-Owner (seedet beim Erstellen 'owner') und Staff/Site-Mods dürfen
        // beliebige Rollen setzen. Verhindert, dass ein normales Mitglied sich selbst
        // per roles:['owner'] zu Community-Staff hochstuft (isCommunityStaff).
        allow create: if isLoggedIn() && isOwner(userId) && (
            request.resource.data.roles == [get(/databases/$(database)/documents/communitys/$(communityId)).data.get('defaultRankName', 'member').lower()] ||
            get(/databases/$(database)/documents/communitys/$(communityId)).data.ownerId == request.auth.uid ||
            isCommunityStaff(communityId) ||
            isModerator()
        );
        allow delete: if isLoggedIn() && (isOwner(userId) || get(/databases/$(database)/documents/communitys/$(communityId)).data.ownerId == request.auth.uid || isAdmin());
        // Rollen darf nur Community-Owner/Staff/Admin ändern. Ein Mitglied darf sein
        // eigenes Doc nur bearbeiten, solange 'roles' unverändert bleibt.
        allow update: if isLoggedIn() && (
            get(/databases/$(database)/documents/communitys/$(communityId)).data.ownerId == request.auth.uid ||
            isCommunityStaff(communityId) ||
            isAdmin() ||
            (isOwner(userId) && request.resource.data.roles == resource.data.roles)
        );
      }
      match /creations/{creationId} {
        allow read: if true;
        // Nur eigene Creations dürfen in Communitys eingehängt werden
        // (Moderatoren dürfen fremde, z. B. beim Bearbeiten im Auftrag).
        allow create: if isLoggedIn() &&
            request.resource.data.userId == request.auth.uid &&
            (get(/databases/$(database)/documents/creations/$(creationId)).data.userId == request.auth.uid ||
             isModerator());
        // Owner der Creation darf sein Link-Doc entfernen (Creation aus der
        // Community nehmen) und sich einmalig für das Showcase bewerben —
        // dabei dürfen nur die Bewerbungsfelder geändert werden.
        allow update: if isLoggedIn() && (
            isCommunityStaff(communityId) || isModerator() ||
            (
                resource.data.userId == request.auth.uid &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['appliedForShowcase', 'appliedAt']) &&
                request.resource.data.appliedForShowcase == true &&
                !('appliedForShowcase' in resource.data && resource.data.appliedForShowcase == true) &&
                // Bereits geshowcaste Creations können sich nicht erneut bewerben
                !('showcaseVideoUrl' in resource.data && resource.data.showcaseVideoUrl != null)
            )
        );
        allow delete: if isLoggedIn() && (isCommunityStaff(communityId) || isModerator() || resource.data.userId == request.auth.uid);
      }
    }

    match /creations/{creationId} {
      allow read: if true;
      allow create: if isLoggedIn() &&
          request.resource.data.userId == request.auth.uid &&
          isValidCreationCreate(request.resource.data);
      // View-Zähler: jeder (auch anonym) darf views um genau 1 erhöhen, ohne andere
      // Felder anzufassen. reportCount wird NICHT mehr vom Client erhöht, sondern
      // serverseitig vom onReportCreated-Trigger (verhindert unbegrenztes Aufblähen).
      allow update: if (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
          request.resource.data.views is int &&
          request.resource.data.views == resource.data.get('views', 0) + 1
      ) || (isLoggedIn() && (
          (isOwner(resource.data.userId) && isValidCreationUpdate(request.resource.data, resource.data)) ||
          isModerator()
      ));
      allow delete: if isLoggedIn() && (isOwner(resource.data.userId) || isModerator());

      match /votes/{userId} {
        allow read: if true;
        allow create: if isLoggedIn() && isOwner(userId) && (
            request.resource.data.type != 'event_vote' ||
            get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.voteType == 'multiple' ||
            (
                get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.voteType == 'single' &&
                !exists(/databases/$(database)/documents/events/$(request.resource.data.eventId)/voters/$(userId))
            )
        );
        allow delete: if isOwner(userId);
      }
      
      // Nur lesen: Der Client schreibt unter creations ausschließlich die
      // votes-Subcollection (eigene strenge Regel oben). Ein Wildcard-write
      // würde die votes-Regel aushebeln und beliebige Subcollections öffnen.
      match /{subcollection}/{docId} {
        allow read: if true;
      }
    }

    // Kompakter Suchindex (ein Doc pro Spiel), wird nur von Cloud Functions
    // (Admin SDK, umgeht Rules) geschrieben — Clients lesen ihn für die Suche.
    match /searchIndex/{gameId} {
      allow read: if true;
      allow write: if false;
    }

    // Community-Suchindex (ein Doc pro Community), analog nur von Functions gepflegt.
    match /communitySearchIndex/{communityId} {
      allow read: if true;
      allow write: if false;
    }

    // Showcase-Index (ein Doc pro Showcase), nur von Cloud Functions gepflegt.
    match /showcaseIndex/{showcaseId} {
      allow read: if true;
      allow write: if false;
    }

    // Bug-Reports: eingeloggte Nutzer melden, nur Admins lesen/verwalten.
    match /bugReports/{reportId} {
      allow create: if isLoggedIn() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'open' &&
          request.resource.data.description is string &&
          request.resource.data.description.size() >= 10 &&
          request.resource.data.description.size() <= 3000;
      allow read, update, delete: if isAdmin();
    }

    match /profiles/{userId} {
      allow read: if true;
      // role wird serverseitig von setCustomClaims (Admin SDK, umgeht Rules) gepflegt.
      // Clients dürfen bei create nur 'user' setzen und role beim update NICHT ändern —
      // sonst könnte man sich selbst zu admin/moderator machen (ProtectedRoute vertraut
      // profile.role fürs UI-Gating).
      allow create: if isOwner(userId) && isValidProfileData(request.resource.data) &&
          (!('role' in request.resource.data.keys()) || request.resource.data.role == 'user');
      allow update: if
          ((isOwner(userId) || isAdmin()) && isValidProfileData(request.resource.data) &&
           (isAdmin() || request.resource.data.get('role', 'user') == resource.data.get('role', 'user')))
          ||
          // Fremdes Profil: eingeloggte Nutzer dürfen sich NUR selbst in die
          // followers-Liste eintragen/austragen (Follow/Unfollow) — nichts anderes.
          (isLoggedIn() &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers']) && (
             (request.auth.uid in request.resource.data.get('followers', []) &&
              !(request.auth.uid in resource.data.get('followers', [])) &&
              request.resource.data.get('followers', []).size() == resource.data.get('followers', []).size() + 1) ||
             (!(request.auth.uid in request.resource.data.get('followers', [])) &&
              request.auth.uid in resource.data.get('followers', []) &&
              request.resource.data.get('followers', []).size() == resource.data.get('followers', []).size() - 1)
           ));
      allow delete: if isOwner(userId) || isAdmin();

      match /communityMemberships/{communityId} {
        allow read: if true;
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == 'user';
      // reportCount wird serverseitig vom onReportCreated-Trigger gepflegt, nicht
      // mehr vom Client (verhindert Zähler-Manipulation/Harassment).
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      // Notification hub: single capped inbox doc (users/{uid}/meta/inbox) with
      // items + unreadCount + prefs + pushTokens. Server (admin) writes items on
      // fan-out; the owner writes prefs/pushTokens/mark-read/clear.
      match /meta/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /following/{creationId} {
        allow read, write: if isOwner(userId);
      }
      match /reportedItems/{creationId} {
        allow read, write: if isOwner(userId);
        allow delete: if isModerator();
      }
    }

    match /usernames/{username} {
      allow read: if true;
      // Bindet die Reservierung an die eigene Konto-E-Mail (verhindert
      // Squatting mit fremden/erfundenen E-Mails). Registrierung ist nur
      // per E-Mail/Passwort möglich, token.email ist also immer gesetzt.
      allow create: if isLoggedIn() &&
          request.resource.data.keys().hasOnly(['email']) &&
          request.resource.data.email == request.auth.token.email.lower();
    }
    
    // Per-creation followers (creationFollowers/{creationId}/followers/{uid}) —
    // drives "notify me when this creation updates". Each user manages only their
    // own follow doc; server fan-out reads these with admin (bypasses rules).
    match /creationFollowers/{creationId}/followers/{followerId} {
        allow read: if true;
        allow create, delete: if isLoggedIn() && isOwner(followerId);
    }

    match /dlcs/{gameId} {
        allow read: if isLoggedIn();
        allow write: if isAdmin();
    }
    match /categories/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isModerator();
    }
    match /mods/{modId} {
      allow read: if true;
      allow write: if isModerator();
    }
    match /meta/{docId} {
        allow read: if true;
        allow write: if isModerator();
    }
    match /reports/{reportId} {
      allow create: if isLoggedIn() &&
          request.resource.data.reporterId == request.auth.uid &&
          request.resource.data.reason is string &&
          request.resource.data.reason.size() > 0 &&
          request.resource.data.reason.size() <= 2000;
      allow list, get: if isModerator();
      allow update, delete: if isModerator();
    }
    match /applications/{userId} {
      allow read, delete: if isAdmin();
      allow create: if isLoggedIn() && isOwner(userId);
    }

    // --- Collaborations ---
    function isCollaborationMember(collaborationId) {
      let memberPath = /databases/$(database)/documents/collaborations/$(collaborationId)/members/$(request.auth.uid);
      return isLoggedIn() && exists(memberPath);
    }
    function isCollaborationOwner(collaborationId) {
      let memberPath = /databases/$(database)/documents/collaborations/$(collaborationId)/members/$(request.auth.uid);
      return isLoggedIn() && exists(memberPath) && get(memberPath).data.role == 'owner';
    }
    // Collaboration owner OR site moderator/admin
    function isCollaborationOwnerOrMod(collaborationId) {
      return isCollaborationOwner(collaborationId) || isModerator();
    }
    function isCollaborationEditor(collaborationId) {
      let memberPath = /databases/$(database)/documents/collaborations/$(collaborationId)/members/$(request.auth.uid);
      return isLoggedIn() && exists(memberPath) && get(memberPath).data.role in ['owner', 'editor'];
    }
    // Collaboration editor OR site moderator/admin
    function isCollaborationEditorOrMod(collaborationId) {
      return isCollaborationEditor(collaborationId) || isModerator();
    }

    match /collaborations/{collaborationId} {
      // Lesen/Listen nur, wenn Mitglied/Owner/Mod. Dadurch sind nur die eigenen
      // Collaborations abfragbar (ownerId==uid bzw. memberIds array-contains uid) —
      // kein Blanket-list mehr, das inviteCodes aller Collaborations preisgibt.
      // Der Beitritt per Code läuft über die Cloud Function joinCollaborationByInviteCode.
      allow read: if isLoggedIn() && (
        isCollaborationMember(collaborationId) ||
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.memberIds ||
        isModerator()
      );
      allow create: if isLoggedIn();
      allow update: if isCollaborationOwnerOrMod(collaborationId) ||
        // Mitglieder dürfen bei memberIds NUR sich selbst hinzufügen (Beitritt/Invite)
        // oder entfernen (Verlassen) — nie andere Mitglieder ändern/entfernen.
        (isLoggedIn() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) && (
           (request.auth.uid in request.resource.data.memberIds &&
            !(request.auth.uid in resource.data.memberIds) &&
            request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1) ||
           (!(request.auth.uid in request.resource.data.memberIds) &&
            request.auth.uid in resource.data.memberIds &&
            request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1)
         ));
      // Allow mods to delete collaborations even if orphaned (no owner member exists)
      allow delete: if isCollaborationOwnerOrMod(collaborationId) || isModerator();

      match /members/{userId} {
        allow read: if isCollaborationMember(collaborationId) || isModerator();
        allow create: if isLoggedIn() && (
          // Owner adding first member (themselves) during creation
          (isOwner(userId) && request.resource.data.role == 'owner') ||
          // Joining via invite code
          isOwner(userId)
        );
        allow update: if isCollaborationOwnerOrMod(collaborationId);
        // Allow mods to delete members even if no owner exists (orphaned collaborations)
        allow delete: if isCollaborationOwnerOrMod(collaborationId) || isOwner(userId) || isModerator();
      }

      match /files/{fileId} {
        allow read: if isCollaborationMember(collaborationId) || isModerator();
        allow create: if isCollaborationEditorOrMod(collaborationId);
        allow update: if isCollaborationEditorOrMod(collaborationId);
        // Allow mods to delete files even for orphaned collaborations
        allow delete: if isCollaborationOwnerOrMod(collaborationId) || isModerator();

        match /versions/{versionId} {
          allow read: if isCollaborationMember(collaborationId) || isModerator();
          allow create: if isCollaborationEditorOrMod(collaborationId);
          allow update: if isCollaborationEditorOrMod(collaborationId);
          // Allow mods to delete versions even for orphaned collaborations
          allow delete: if isCollaborationOwnerOrMod(collaborationId) ||
            (isCollaborationEditor(collaborationId) && resource.data.uploadedBy == request.auth.uid) ||
            isModerator();
        }
      }

      match /comments/{commentId} {
        allow read: if isCollaborationMember(collaborationId) || isModerator();
        allow create: if isCollaborationMember(collaborationId) || isModerator();
        allow update: if isLoggedIn() && (resource.data.userId == request.auth.uid || isModerator());
        // Allow mods to delete comments even for orphaned collaborations
        allow delete: if isCollaborationOwnerOrMod(collaborationId) ||
          (isLoggedIn() && resource.data.userId == request.auth.uid) ||
          isModerator();
      }

      match /invitations/{inviteId} {
        allow read: if isCollaborationMember(collaborationId) ||
          (isLoggedIn() && resource.data.targetUserId == request.auth.uid) ||
          isModerator();
        allow create: if isCollaborationOwnerOrMod(collaborationId) || isModerator();
        allow update: if isLoggedIn() && resource.data.targetUserId == request.auth.uid;
        // Allow mods to delete invitations even for orphaned collaborations
        allow delete: if isCollaborationOwnerOrMod(collaborationId) || isModerator();
      }

      // Todo items
      match /todos/{todoId} {
        allow read: if isCollaborationMember(collaborationId) || isModerator();
        allow create: if isCollaborationMember(collaborationId) || isModerator();
        allow update: if isCollaborationMember(collaborationId) || isModerator();
        allow delete: if isCollaborationOwnerOrMod(collaborationId) ||
          (isLoggedIn() && resource.data.createdBy == request.auth.uid) ||
          isModerator();
      }

      // Work sessions (build history)
      match /workSessions/{sessionId} {
        allow read: if isCollaborationMember(collaborationId) || isModerator();
        allow create: if isCollaborationMember(collaborationId) || isModerator();
        allow update: if isLoggedIn() && resource.data.userId == request.auth.uid;
        allow delete: if isCollaborationOwnerOrMod(collaborationId) || isModerator();
      }

      // Upload entries (changelog history)
      match /uploads/{uploadId} {
        allow read: if isCollaborationMember(collaborationId) || isModerator();
        allow create: if isCollaborationEditorOrMod(collaborationId);
        allow delete: if isCollaborationOwnerOrMod(collaborationId) || isModerator();
      }
    }

    // User's collaboration invites (notifications)
    match /users/{userId}/collaborationInvites/{inviteId} {
      allow read: if isOwner(userId);
      // Nur echte Mitglieder der Collaboration dürfen Einladungen versenden
      // (senderId muss der eigene uid sein) — verhindert Invite-Spam an beliebige Nutzer.
      allow create: if isLoggedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          (isCollaborationMember(request.resource.data.collaborationId) || isModerator());
      allow update: if isOwner(userId);
      // Empfänger, echter Absender oder ein Collaboration-Owner/Mod
      // (cancelInvitation darf auch ein Mit-Owner ausführen, der nicht
      // der ursprüngliche Absender ist).
      allow delete: if isOwner(userId) ||
          (isLoggedIn() && resource.data.senderId == request.auth.uid) ||
          isCollaborationOwnerOrMod(resource.data.collaborationId);
    }
  }
}