{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "test": "node --test backupFormat.test.js collaborationChangelogState.test.js collaborationPublicView.test.js collaborationVersioning.test.js communityMembership.test.js runtime.test.js security.test.js",
    "serve": "firebase emulators:start --only functions",
