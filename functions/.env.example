# Nicht-geheime Konfiguration (wird beim Deploy hochgeladen).
# Secrets (DISCORD_CLIENT_SECRET, BACKUP_SIGNING_KEY, R2_ACCESS_KEY_ID,
# R2_SECRET_ACCESS_KEY, TWITCH_CLIENT_ID, TWITCH_CLIENT_SECRET,
# YOUTUBE_API_KEY) NICHT hier eintragen,
# sondern: firebase functions:secrets:set <NAME>
DISCORD_CLIENT_ID=
DISCORD_REDIRECT_URI=
# Öffentlicher HTTPS-Callback für YouTube WebSub. Der Production-Default zeigt
# bereits auf /api/youtubeWebSub und muss nur bei anderen Projekten gesetzt werden.
YOUTUBE_WEBSUB_CALLBACK_URL=

# Cloudflare R2 (privater Bucket; Downloads werden kurzzeitig signiert)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
# Nur bei einem Bucket mit Jurisdiktion setzen, z. B. eu
R2_JURISDICTION=
BACKUP_SIGNING_KEY_ID=backup-rsa-2026-01

# Enable only after the web app has a registered App Check provider.
ENFORCE_APP_CHECK=false
FUNCTIONS_SERVICE_ACCOUNT=planetcreationsdotnet@appspot.gserviceaccount.com
