{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "**/*.test.js",
        "scripts",
        "eslint.config.js",
        "**/*.md",
        "**/*.log",
        ".local-notes",
        ".env.example",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "runtime": "nodejs22"
    }
  ]
}
